//========= mapbase-fidelity ==================================================//
//
// Vertex shader of Fidelity_Parallax's light pass (flashlight, projected
// textures, the sun's shadows of env_global_light), after Mapbase's
// lightmappedgeneric_flashlight_vs20.fxc: the position exactly as the main
// pass (else the added light flickers against it), base and bump map
// texture coordinates (with their transforms), world position and normal,
// and the position in the light's texture (spot and shadow map).
//
// Blended surfaces (BLEND): the painted blend from the vertex colour's alpha
// (as WorldVertexTransition) in worldNormal.w, and the second layer's base
// texture (xy) and height and bump map (zw) coordinates.
//
//=============================================================================//

// DYNAMIC: "BLEND"		"0..1"

#include "common_vs_fxc.h"

const float4 cBaseTexCoordTransform[ 2 ]		: register( SHADER_SPECIFIC_CONST_0 );
const float4 cBase2TexCoordTransform[ 2 ]	: register( SHADER_SPECIFIC_CONST_8 );
const float4 cBump2TexCoordTransform[ 2 ]	: register( SHADER_SPECIFIC_CONST_10 );
const float4 cBumpTexCoordTransform[ 2 ]		: register( SHADER_SPECIFIC_CONST_2 );
const float4x4 g_FlashlightWorldToTexture		: register( SHADER_SPECIFIC_CONST_4 );

struct VS_INPUT
{
	float3 vPos				: POSITION;
	float4 vNormal			: NORMAL;
	float2 vBaseTexCoord	: TEXCOORD0;
#if BLEND
	float4 vColor			: COLOR0;
#endif
};

struct VS_OUTPUT
{
	float4 projPos				: POSITION;
	float4 baseAndBumpTexCoord	: TEXCOORD0;	// base (xy), bump map (zw)
	float4 spotTexCoord			: TEXCOORD1;	// in the light's texture
	float4 worldPos_projPosZ	: TEXCOORD2;
	float4 worldNormal			: TEXCOORD3;	// w: painted blend (blended surfaces)
	float3 projPosXYW			: TEXCOORD4;	// screen position (shadow noise)
	float4 base2AndBump2TexCoord	: TEXCOORD5;
};

VS_OUTPUT main( const VS_INPUT v )
{
	VS_OUTPUT o = ( VS_OUTPUT )0;

	float3 vObjNormal;
	DecompressVertex_Normal( v.vNormal, vObjNormal );

	const float4 vProjPos = mul( float4( v.vPos, 1 ), cModelViewProj );
	o.projPos = vProjPos;
	o.projPosXYW = vProjPos.xyw;
	const float3 worldPos = mul( float4( v.vPos, 1 ), cModel[ 0 ] );
	o.worldPos_projPosZ = float4( worldPos, dot( float4( v.vPos, 1 ), cModelViewProjZ ) );
	o.worldNormal.xyz = normalize( mul( vObjNormal, ( float3x3 )cModel[ 0 ] ) );
	o.spotTexCoord = mul( float4( worldPos, 1.0 ), g_FlashlightWorldToTexture );

	o.baseAndBumpTexCoord.x = dot( v.vBaseTexCoord, cBaseTexCoordTransform[ 0 ].xy ) + cBaseTexCoordTransform[ 0 ].w;
	o.baseAndBumpTexCoord.y = dot( v.vBaseTexCoord, cBaseTexCoordTransform[ 1 ].xy ) + cBaseTexCoordTransform[ 1 ].w;
	o.baseAndBumpTexCoord.z = dot( v.vBaseTexCoord, cBumpTexCoordTransform[ 0 ].xy ) + cBumpTexCoordTransform[ 0 ].w;
	o.baseAndBumpTexCoord.w = dot( v.vBaseTexCoord, cBumpTexCoordTransform[ 1 ].xy ) + cBumpTexCoordTransform[ 1 ].w;
#if BLEND
	o.worldNormal.w = v.vColor.a;
	o.base2AndBump2TexCoord.x = dot( v.vBaseTexCoord, cBase2TexCoordTransform[ 0 ].xy ) + cBase2TexCoordTransform[ 0 ].w;
	o.base2AndBump2TexCoord.y = dot( v.vBaseTexCoord, cBase2TexCoordTransform[ 1 ].xy ) + cBase2TexCoordTransform[ 1 ].w;
	o.base2AndBump2TexCoord.z = dot( v.vBaseTexCoord, cBump2TexCoordTransform[ 0 ].xy ) + cBump2TexCoordTransform[ 0 ].w;
	o.base2AndBump2TexCoord.w = dot( v.vBaseTexCoord, cBump2TexCoordTransform[ 1 ].xy ) + cBump2TexCoordTransform[ 1 ].w;
#endif
	return o;
}
