//========= mapbase-fidelity ==================================================//
//
// Vertex shader of Fidelity_Volumetric (light in the air of a flashlight or
// projected texture): a screen rectangle as the engine's screen-space effects
// draw it - the position is already in projection space - with its texture
// coordinate. (ps_3_0 needs a vs_3_0 beside it.)
//
//=============================================================================//

#include "common_vs_fxc.h"

struct VS_INPUT
{
	float3 vPos			: POSITION;
	float2 vTexCoord	: TEXCOORD0;
};

struct VS_OUTPUT
{
	float4 projPos		: POSITION;
	float2 texCoord		: TEXCOORD0;
};

VS_OUTPUT main( const VS_INPUT v )
{
	VS_OUTPUT o = ( VS_OUTPUT )0;
	o.projPos = float4( v.vPos, 1.0f );
	o.texCoord = v.vTexCoord;
	return o;
}
